{
  "name": "ai-comments",
  "version": "0.1.0",
  "description": "Review comments on a web page, worked off by Claude or by an agent outside the dev server. A tiny Vite dev-server plugin.",
  "type": "module",
  "main": "src/plugin.js",
  "exports": {
    ".": {
      "types": "./src/plugin.d.ts",
      "default": "./src/plugin.js"
    }
  },
  "bin": {
    "ai-comments": "bin/cli.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "demo": "vite examples/demo"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "vite": "^7.3.8"
  },
  "types": "src/plugin.d.ts"
}
